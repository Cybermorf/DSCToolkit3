<UserControl
    x:Class="DSC.Toolkit.Controls.RecordEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="FieldsPanel" Spacing="10">
            <TextBlock Text="Select or create a record to edit it." Foreground="{StaticResource SecondaryTextBrush}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
